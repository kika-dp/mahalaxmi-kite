{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "ts-node -r tsconfig-paths/register src/database/cli/migrate.ts run",
    "migration:revert": "ts-node -r tsconfig-paths/register src/database/cli/migrate.ts revert",
    "migration:run:prod": "node dist/database/cli/migrate.js run",
    "seed:dev": "ts-node -r tsconfig-paths/register src/database/seeds/dev-seed.ts",
    "bootstrap:prod": "node dist/database/seeds/prod-bootstrap.js",
    "load": "ts-node test/load/checkout-load.ts"
  },
  "dependencies": {
    "@kite/shared": "workspace:*",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@nestjs/typeorm": "11.0.3",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "nestjs-pino": "4.6.1",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.11",
    "@types/autocannon": "7.12.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "6.0.3",
    "autocannon": "8.0.0",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
