{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "export:ios": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@kite/api-client": "workspace:*",
    "@kite/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "5.90.2",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-query-persist-client": "5.90.2",
    "expo": "58.0.26",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true,
            "strict": true
          }
        }
      ]
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ]
  }
}
