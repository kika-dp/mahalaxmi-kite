{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "export:ios": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@kite/api-client": "workspace:*",
    "@kite/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/query-async-storage-persister": "5.90.2",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-query-persist-client": "5.90.2",
    "expo": "54.0.38",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "19.1.17",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": { "module": "commonjs", "esModuleInterop": true, "strict": true } }] },
    "testMatch": ["<rootDir>/src/**/*.test.ts"]
  }
