# ============================================================
# Kite Shop Platform — environment template
# Copy to .env (repo root). Never commit real secrets.
# ============================================================

# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=4000
# Full PostgreSQL connection string
DATABASE_URL=postgres://kite:kite@localhost:5432/kite
# Used only by the integration test suite (database is dropped and recreated!)
DATABASE_URL_TEST=postgres://kite:kite@localhost:5432/kite_test
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# Secrets: generate with `openssl rand -base64 48`. Min 32 chars. Boot fails otherwise.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_REMEMBER_DAYS=7
REFRESH_TTL_SESSION_HOURS=12

# Comma-separated origins allowed by CORS (the CRM). Mobile apps are not browsers and do not need CORS.
CORS_ORIGINS=http://localhost:3000
# Cookie settings for the CRM refresh-token cookie
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Where uploaded images are stored (mounted volume in production)
UPLOAD_DIR=./uploads
# Public base URL of the API (used to build image URLs)
PUBLIC_API_URL=http://localhost:4000

LOG_LEVEL=info
SWAGGER_ENABLED=true
TZ_BUSINESS=Asia/Kolkata

# Dev seeder: set false only for automated tests
SEED_MUST_CHANGE_PASSWORD=true

# Production bootstrap (pnpm --filter api bootstrap:prod). Leave empty in development.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- CRM (apps/crm) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---------- Mobile (apps/mobile) ----------
# On a physical iPhone use your Mac's LAN IP, e.g. http://192.168.1.20:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
